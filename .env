# KharchaSplit Environment Configuration

# ===================================
# PostgreSQL Backend API Configuration
# ===================================

# Your PostgreSQL backend API base URL
# For local development: Use your local machine's IP address
# For production: Use your deployed backend URL
API_BASE_URL= "https://api.kharchasplit.com"
# API_BASE_URL= "http://192.168.1.8:3000"

# API timeout in milliseconds (default: 30000)
API_TIMEOUT=30000

# ===================================
# Database Configuration
# ===================================

# Enable auto-sync (true/false)
AUTO_SYNC_ENABLED=true

# Auto-sync interval in minutes (default: 5)
AUTO_SYNC_INTERVAL=5

# ===================================
# Firebase Configuration (if still using)
# ===================================

# Keep your existing Firebase config if you're gradually migrating
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# ===================================
# Optional: Development Settings
# ===================================

# Enable debug logging (true/false)
DEBUG_MODE=true

# Mock API for testing without backend (true/false)
USE_MOCK_API=false
